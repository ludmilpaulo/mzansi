# =============================================================================
# Mzansi Visa Solutions — environment template
# Copy to .env (repo root) and/or backend/.env. Never commit real secrets.
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_PRODUCTION=false
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Database (leave empty to use SQLite for local development) ---
# DATABASE_URL=postgres://mzansi:mzansi@localhost:5432/mzansi

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Email (console backend is used automatically when DEBUG=true and no password) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mzansi Visa Solutions <noreply@mzansivisa.co.za>

# --- Object storage (private documents). Leave USE_S3_STORAGE=false for local. ---
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- CORS extras (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Mzansi Visa Solutions

# --- Field encryption (Fernet). Required in production. ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Official VFS tracking API only. Leave empty to use the official VFS page fallback. ---
# Do not scrape visa.vfsglobal.com. Automated access is not permitted.
VFS_TRACKING_API_BASE_URL=
VFS_TRACKING_API_KEY=

# --- Expo ---
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
